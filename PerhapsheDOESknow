local function safeTableFind(tbl, target)
	if type(tbl) ~= "table" or target == nil then return nil end
	for idx, val in pairs(tbl) do
		if typeof(val) == "Instance" and typeof(target) == "Instance" then
			if val == target then return idx end
		elseif tostring(val) == tostring(target) then
			return idx
		end
	end
	return nil
end

local function saveProfileData()
	pcall(function()
		if writefile then
			local package = {
				Offsets = CustomOffsets,
				AssetIds = AssetIdsToLoad,
				ExtractedNames = ExtractedNamesToLoad,
				ExtractedVisuals = ExtractedVisuals,
				Slots = SaveSlots,
				SlotNames = SlotNames
			}
			writefile(FILE_NAME, HttpService:JSONEncode(package))
		end
	end)
end

local function loadProfileData()
	local success, result = pcall(function()
		if readfile and isfile and isfile(FILE_NAME) then
			return readfile(FILE_NAME)
		end
		return nil
	end)
	
	if success and result and type(result) == "string" then
		local successParse, parsedData = pcall(function()
			return HttpService:JSONDecode(result)
		end)
		
		if successParse and type(parsedData) == "table" then
			CustomOffsets = type(parsedData.Offsets) == "table" and parsedData.Offsets or {}
			AssetIdsToLoad = type(parsedData.AssetIds) == "table" and parsedData.AssetIds or {}
			ExtractedNamesToLoad = type(parsedData.ExtractedNames) == "table" and parsedData.ExtractedNames or {}
			ExtractedVisuals = type(parsedData.ExtractedVisuals) == "table" and parsedData.ExtractedVisuals or {}
			SaveSlots = type(parsedData.Slots) == "table" and parsedData.Slots or {}
			SlotNames = type(parsedData.SlotNames) == "table" and parsedData.SlotNames or {}
			return
		end
	end
end

loadProfileData()

local function getSaveSlotCount()
	local maxSlot = 0
	for slotKey, _ in pairs(SaveSlots) do
		local numericKey = tonumber(slotKey)
		if numericKey and numericKey > maxSlot then
			maxSlot = numericKey
		end
	end
	return math.max(maxSlot, 5)
end

local function ensureSaveSlot(slotNumber)
	local slotKey = tostring(slotNumber)
	if SaveSlots[slotKey] == nil and SaveSlots[slotNumber] == nil then
		SaveSlots[slotKey] = { Empty = true }
	end
	if SlotNames[slotKey] == nil and SlotNames[slotNumber] == nil then
		SlotNames[slotKey] = "SLOT " .. slotKey
	end
end

for i = 1, 5 do ensureSaveSlot(i) end

