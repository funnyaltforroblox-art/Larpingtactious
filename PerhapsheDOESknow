		if tierData and tierData[selectedItemKey] and tierData[selectedItemKey][selectedSubPartName] then
			local val = tonumber(textBox.Text)
			if val then
				if isTransparencyField then
					local clampedAlpha = normalizeTransparency(val, tierData[selectedItemKey][selectedSubPartName][property] or 0)
					tierData[selectedItemKey][selectedSubPartName][property] = clampedAlpha
					textBox.Text = string.format("%.2f", clampedAlpha)
				else
