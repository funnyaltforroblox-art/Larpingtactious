			if isPreviewingMode then runUpdatePreviewCycle() end
		end)
	end

	TierSelectionPanel.CanvasSize = UDim2.new(0, 0, 0, #tiers * 30)
end

restoreAllTierAssets = function()
	if type(AssetIdsToLoad) == "table" then
		for tierName, idList in pairs(AssetIdsToLoad) do
			if type(idList) == "table" then
				for _, id in pairs(idList) do
					if id ~= nil then
						local validId = id
						local validTier = tierName
						task.spawn(function()
							injectAssetId(validId, validTier, true)
						end)
					end
				end
			end
		end
	end
	
	if type(ExtractedNamesToLoad) == "table" then
		for tierName, extractionList in pairs(ExtractedNamesToLoad) do
			if type(extractionList) == "table" then
				for _, name in pairs(extractionList) do
					if type(name) == "string" and name ~= "" then
						generateExtractedPlaceholderModel(tierName, name)
					end
				end
			end
		end
	end

	task.wait(0.2)
	updateItemUI()
	updateEditorUI()
end

updateTierUI()
