injectAssetId = function(id, tierName, isSilentRestore)
	if id == nil then return false end
	local strId = tostring(id)
	if strId == "" then return false end
	
	tierName = tostring(tierName or Config.SelectedDefault)
	local targetFolder = TargetPresetFolder:FindFirstChild(tierName)
	if not targetFolder then return false end

	local success, assetModel = pcall(function()
		return game:GetObjects("rbxassetid://" .. strId)[1]
	end)
	
	if (not success or typeof(assetModel) ~= "Instance") and type(ExtractedVisuals[tierName]) == "table" then
		for itemName, parts in pairs(ExtractedVisuals[tierName]) do
			if type(parts) == "table" then
				local match = false
				for partName, visualData in pairs(parts) do
					if type(visualData) == "table" then
						local meshStr = visualData.MeshId and tostring(visualData.MeshId) or ""
						if meshStr ~= "" and type(meshStr) == "string" and type(strId) == "string" then
							if string.find(meshStr, strId, 1, true) then
								match = true
								break
							end
						end
					end
				end
				
				if match then
					assetModel = generateExtractedPlaceholderModel(tierName, itemName)
					if typeof(assetModel) == "Instance" then
						success = true
						break
					end
				end
			end
		end
	end
	
	if success and typeof(assetModel) == "Instance" then
		if type(assetModel.Name) == "string" and not string.find(assetModel.Name, "Asset_") and not assetModel:IsA("Accessory") then
			assetModel.Name = "Asset_" .. strId
		end
		
		assetModel.Parent = targetFolder
		
		if not AssetIdsToLoad[tierName] or type(AssetIdsToLoad[tierName]) ~= "table" then
			AssetIdsToLoad[tierName] = {}
		end

		if not safeTableFind(AssetIdsToLoad[tierName], strId) then
			table.insert(AssetIdsToLoad[tierName], tonumber(strId) or strId)
		end
		
		initializeItemData(tierName, assetModel)
		
		if not isSilentRestore then
			selectedItemName = assetModel.Name
			selectedSubPartName = "Handle"
			
			if isPreviewingMode then
				runUpdatePreviewCycle()
			elseif LocalPlayer.Character then
				applyPreset(LocalPlayer.Character, lastPreset)
			end
			
			updateItemUI()
			updateEditorUI()
			saveProfileData()
		end

		return true
	end
	
	return false
end

