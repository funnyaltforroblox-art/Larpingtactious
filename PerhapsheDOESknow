local function getSaveSlotCount()
	local maxSlot = 0
	for slotKey, _ in pairs(SaveSlots) do
		local numericKey = tonumber(slotKey)
		if numericKey and numericKey > maxSlot then
			maxSlot = numericKey
		end
	end
	return math.max(maxSlot, 5)
end

local function ensureSaveSlot(slotNumber)
	local slotKey = tostring(slotNumber)
	if SaveSlots[slotKey] == nil and SaveSlots[slotNumber] == nil then
		SaveSlots[slotKey] = {
			Empty = true,
			Thresholds = getDefaultThresholdsCopy(),
			CustomCategories = {}
		}
	elseif SaveSlots[slotNumber] ~= nil and SaveSlots[slotKey] == nil then
		SaveSlots[slotKey] = SaveSlots[slotNumber]
		SaveSlots[slotNumber] = nil
	end

	if type(SaveSlots[slotKey]) == "table" then
		if type(SaveSlots[slotKey].Thresholds) ~= "table" then
			SaveSlots[slotKey].Thresholds = getDefaultThresholdsCopy()
		end
		if type(SaveSlots[slotKey].CustomCategories) ~= "table" then
			SaveSlots[slotKey].CustomCategories = {}
		end
	end

	if SlotNames[slotKey] == nil and SlotNames[slotNumber] == nil then
		SlotNames[slotKey] = "SLOT " .. slotKey
	elseif SlotNames[slotNumber] ~= nil and SlotNames[slotKey] == nil then
		SlotNames[slotKey] = SlotNames[slotNumber]
		SlotNames[slotNumber] = nil
	end
end

