local function drawSaveSlotsInterface()
	for _, child in ipairs(SlotFramePanel:GetChildren()) do
		if typeof(child) == "Instance" and (child:IsA("Frame") or child.Name == "AddSlotButton") then 
			child:Destroy() 
		end
	end
	
	local slotCount = getSaveSlotCount()

	for i = 1, slotCount do
		ensureSaveSlot(i)
		local slotKey = tostring(i)
		local slotData = SaveSlots[slotKey] or SaveSlots[i]
		local isEmpty = not slotData or slotData.Empty == true
		local isActive = (activeSlotKey == slotKey)
		local slotDisplayName = SlotNames[slotKey] or SlotNames[i] or ("SLOT " .. slotKey)
		
		local card = Instance.new("Frame")
		card.Size = UDim2.new(0, 144, 0, 44)
		card.BackgroundColor3 = isActive and Color3.fromRGB(36, 48, 44) or Color3.fromRGB(30, 30, 38)
		card.BorderSizePixel = 0
		card.LayoutOrder = i
		card.Parent = SlotFramePanel
		
		local cardCorner = Instance.new("UICorner")
		cardCorner.CornerRadius = UDim.new(0, 4)
		cardCorner.Parent = card
		
		local statusLabel = Instance.new("TextLabel")
		statusLabel.Size = UDim2.new(1, -30, 0, 16)
		statusLabel.Position = UDim2.new(0, 6, 0, 2)
		statusLabel.BackgroundTransparency = 1
		statusLabel.Font = Enum.Font.GothamBold
		statusLabel.Text = slotDisplayName .. (isActive and " [ACTIVE]" or (isEmpty and " [EMPTY]" or ""))
		statusLabel.TextColor3 = isEmpty and Color3.fromRGB(130, 130, 140) or Color3.fromRGB(0, 255, 150)
		statusLabel.TextSize = 9
		statusLabel.TextXAlignment = Enum.TextXAlignment.Left
		statusLabel.Parent = card
		
		local renameBtn = Instance.new("TextBox")
		renameBtn.Size = UDim2.new(0, 22, 0, 14)
		renameBtn.Position = UDim2.new(1, -26, 0, 3)
		renameBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		renameBtn.Font = Enum.Font.GothamBold
		renameBtn.Text = "✏️"
		renameBtn.TextColor3 = Color3.fromRGB(200, 200, 205)
		renameBtn.TextSize = 8
		renameBtn.ClearTextOnFocus = true
		renameBtn.Parent = card
		
		local rnCorner = Instance.new("UICorner")
		rnCorner.CornerRadius = UDim.new(0, 3)
		rnCorner.Parent = renameBtn
		
		renameBtn.FocusLost:Connect(function()
			local filteredText = string.gsub(renameBtn.Text, "^%s*(.-)%s*$", "%1")
			if filteredText ~= "" and filteredText ~= "✏️" and filteredText ~= "Invalid!" then
				SlotNames[slotKey] = string.sub(filteredText, 1, 16)
			else
				SlotNames[slotKey] = "SLOT " .. slotKey
			end
			saveProfileData()
			drawSaveSlotsInterface()
		end)
		
		local loadBtn = Instance.new("TextButton")
		loadBtn.Size = UDim2.new(0, 62, 0, 18)
		loadBtn.Position = UDim2.new(0, 6, 0, 20)
		loadBtn.BackgroundColor3 = isEmpty and Color3.fromRGB(45, 45, 50) or Color3.fromRGB(0, 100, 180)
		loadBtn.Font = Enum.Font.GothamBold
		loadBtn.Text = "LOAD"
		loadBtn.TextColor3 = isEmpty and Color3.fromRGB(160, 160, 160) or Color3.fromRGB(255, 255, 255)
		loadBtn.TextSize = 9
		loadBtn.Parent = card
		
		local lCc = Instance.new("UICorner")
		lCc.CornerRadius = UDim.new(0, 3)
		lCc.Parent = loadBtn
		
		local saveBtn = Instance.new("TextButton")
		saveBtn.Size = UDim2.new(0, 62, 0, 18)
		saveBtn.Position = UDim2.new(0, 76, 0, 20)
		saveBtn.BackgroundColor3 = Color3.fromRGB(150, 90, 0)
		saveBtn.Font = Enum.Font.GothamBold
		saveBtn.Text = "SAVE"
		saveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		saveBtn.TextSize = 9
		saveBtn.Parent = card
		
		local sCc = Instance.new("UICorner")
		sCc.CornerRadius = UDim.new(0, 3)
		sCc.Parent = saveBtn
		
		saveBtn.Activated:Connect(function()
			activeSlotKey = slotKey
			SaveSlots[slotKey] = {
				Empty = false,
				Offsets = cloneTable(CustomOffsets),
				AssetIds = cloneTable(AssetIdsToLoad),
				ExtractedNames = cloneTable(ExtractedNamesToLoad),
				ExtractedVisuals = cloneTable(ExtractedVisuals),
				Thresholds = cloneTable(ActiveThresholds),
				CustomCategories = cloneTable(ActiveCustomCategories)
			}
			saveProfileData()
			drawSaveSlotsInterface()
			
			local originalText = saveBtn.Text
			saveBtn.Text = "SAVED!"
			saveBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 70)
			task.wait(0.8)
			saveBtn.Text = originalText
			saveBtn.BackgroundColor3 = Color3.fromRGB(150, 90, 0)
		end)
		
		loadBtn.Activated:Connect(function()
			if isEmpty or not slotData then
				loadBtn.Text = "EMPTY!"
				task.wait(0.8)
				loadBtn.Text = "LOAD"
				return
			end

			activeSlotKey = slotKey

			for _, folder in ipairs(TargetPresetFolder:GetChildren()) do
				if typeof(folder) == "Instance" then
					folder:ClearAllChildren()
				end
			end

			CustomOffsets = cloneTable(slotData.Offsets or {})
			AssetIdsToLoad = cloneTable(slotData.AssetIds or {})
			ExtractedNamesToLoad = cloneTable(slotData.ExtractedNames or {})
			ExtractedVisuals = cloneTable(slotData.ExtractedVisuals or {})

			ActiveThresholds = getDefaultThresholdsCopy()
			if type(slotData.Thresholds) == "table" then
				for k, v in pairs(slotData.Thresholds) do
					local keyStr = tostring(k)
					ActiveThresholds[keyStr] = normalizeThreshold(v, ActiveThresholds[keyStr] or 0.5)
				end
			end

			ActiveCustomCategories = {}
			if type(slotData.CustomCategories) == "table" then
				for _, cat in ipairs(slotData.CustomCategories) do
					if type(cat) == "table" and type(cat.Name) == "string" and cat.Name ~= "" then
						table.insert(ActiveCustomCategories, {
							Name = cat.Name,
							MaxRatio = normalizeThreshold(cat.MaxRatio, 0.5)
						})
					end
				end
			end

			local validTiers = getAllTierNames()
			local isSelectedTierValid = false
			for _, tName in ipairs(validTiers) do
				if tName == selectedTierName then
					isSelectedTierValid = true
					break
				end
			end
			if not isSelectedTierValid then
				selectedTierName = Config.SelectedDefault
				selectedItemKey = ""
				selectedItemDisplayName = ""
				selectedSubPartName = "Handle"
			end
			
			ensureDirectoryStructure()
			restoreAllTierAssets()
			drawSaveSlotsInterface()
			
			if isPreviewingMode then
				runUpdatePreviewCycle()
			elseif LocalPlayer.Character then
				lastPreset = ""
				forceRecalculateHealthPreset(LocalPlayer.Character)
			end
			
			updateTierUI()
			updateItemUI()
			updateEditorUI()
			updateThresholdEditorUI()
			
			loadBtn.Text = "LOADED!"
			task.wait(0.8)
			loadBtn.Text = "LOAD"
		end)
	end

	local addSlotBtn = Instance.new("TextButton")
	addSlotBtn.Name = "AddSlotButton"
	addSlotBtn.Size = UDim2.new(0, 144, 0, 30)
	addSlotBtn.BackgroundColor3 = Color3.fromRGB(0, 105, 75)
	addSlotBtn.BorderSizePixel = 0
	addSlotBtn.Font = Enum.Font.GothamBold
	addSlotBtn.Text = "+ ADD SAVE SLOT"
	addSlotBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	addSlotBtn.TextSize = 10
	addSlotBtn.LayoutOrder = slotCount + 1
	addSlotBtn.Parent = SlotFramePanel

	local addSlotCorner = Instance.new("UICorner")
	addSlotCorner.CornerRadius = UDim.new(0, 4)
	addSlotCorner.Parent = addSlotBtn

	addSlotBtn.Activated:Connect(function()
		local newSlotNumber = getSaveSlotCount() + 1
		ensureSaveSlot(newSlotNumber)
		saveProfileData()
		drawSaveSlotsInterface()
	end)

	SlotFramePanel.CanvasSize = UDim2.new(0, 0, 0, (slotCount * 50) + 42)
end

updateThresholdEditorUI = function()
	for _, child in ipairs(ThresholdEditorScroll:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UICorner") then
			child:Destroy()
		end
	end

	local orderCounter = 1
	local function nextOrder()
		local o = orderCounter
		orderCounter = orderCounter + 1
		return o
	end

	local slotScopeLabel = Instance.new("TextLabel")
	slotScopeLabel.Size = UDim2.new(1, -8, 0, 20)
	slotScopeLabel.BackgroundTransparency = 1
	slotScopeLabel.Font = Enum.Font.GothamBold
	slotScopeLabel.Text = activeSlotKey and ("SLOT " .. activeSlotKey .. " (0-1 or 'nil')") or "THRESHOLDS (0-1 or 'nil')"
	slotScopeLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
	slotScopeLabel.TextSize = 9
	slotScopeLabel.TextXAlignment = Enum.TextXAlignment.Left
	slotScopeLabel.LayoutOrder = nextOrder()
	slotScopeLabel.Parent = ThresholdEditorScroll

	local defaultDamageTiers = {
		Config.SelectedMinor,
		Config.SelectedMedium,
		Config.SelectedMajor,
		Config.SelectedCritical
	}

	for _, tierName in ipairs(defaultDamageTiers) do
		ensureSubFolder(tierName)
		local currentVal = ActiveThresholds[tierName]
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 22)
		row.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
		row.BorderSizePixel = 0
		row.LayoutOrder = nextOrder()
		row.Parent = ThresholdEditorScroll

		local rCorner = Instance.new("UICorner")
		rCorner.CornerRadius = UDim.new(0, 4)
		rCorner.Parent = row

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(0.62, -4, 1, 0)
		lbl.Position = UDim2.new(0, 4, 0, 0)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamSemibold
		lbl.Text = tierName
		lbl.TextColor3 = isNilThreshold(currentVal) and Color3.fromRGB(135, 135, 150) or Color3.fromRGB(220, 220, 230)
		lbl.TextSize = 9
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Parent = row

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0.36, 0, 0, 18)
		box.Position = UDim2.new(0.62, 0, 0, 2)
		box.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
		box.BorderSizePixel = 0
		box.Font = Enum.Font.GothamBold
		box.Text = formatThresholdText(currentVal)
		box.TextColor3 = isNilThreshold(currentVal) and Color3.fromRGB(255, 130, 130) or Color3.fromRGB(255, 220, 120)
		box.TextSize = 9
		box.ClearTextOnFocus = false
		box.Parent = row

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(0, 3)
		bCorner.Parent = box

		box.FocusLost:Connect(function()
			local raw = box.Text
			if isNilThreshold(raw) then
				ActiveThresholds[tierName] = "nil"
				box.Text = "nil"
				box.TextColor3 = Color3.fromRGB(255, 130, 130)
				lbl.TextColor3 = Color3.fromRGB(135, 135, 150)
				saveProfileData()
				if not isPreviewingMode and LocalPlayer.Character then
					lastPreset = ""
					forceRecalculateHealthPreset(LocalPlayer.Character)
				end
				return
			end

			local parsed = tonumber(raw)
			if parsed then
				local clamped = normalizeThreshold(parsed, ActiveThresholds[tierName] or 0.5)
				ActiveThresholds[tierName] = clamped
				box.Text = formatThresholdText(clamped)
				box.TextColor3 = Color3.fromRGB(255, 220, 120)
				lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
				saveProfileData()
				if not isPreviewingMode and LocalPlayer.Character then
					lastPreset = ""
					forceRecalculateHealthPreset(LocalPlayer.Character)
				end
			else
				box.Text = formatThresholdText(ActiveThresholds[tierName])
			end
		end)
	end

	local customHeader = Instance.new("TextLabel")
	customHeader.Size = UDim2.new(1, -8, 0, 18)
	customHeader.BackgroundTransparency = 1
	customHeader.Font = Enum.Font.GothamBold
	customHeader.Text = "SLOT CUSTOM CATEGORIES"
	customHeader.TextColor3 = Color3.fromRGB(130, 200, 255)
	customHeader.TextSize = 9
	customHeader.TextXAlignment = Enum.TextXAlignment.Left
	customHeader.LayoutOrder = nextOrder()
	customHeader.Parent = ThresholdEditorScroll

	local newNameBox = Instance.new("TextBox")
	newNameBox.Size = UDim2.new(1, -8, 0, 20)
	newNameBox.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	newNameBox.BorderSizePixel = 0
	newNameBox.Font = Enum.Font.Gotham
	newNameBox.PlaceholderText = "New category name..."
	newNameBox.Text = ""
	newNameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	newNameBox.TextSize = 9
	newNameBox.ClearTextOnFocus = true
	newNameBox.LayoutOrder = nextOrder()
	newNameBox.Parent = ThresholdEditorScroll

	local nnCorner = Instance.new("UICorner")
	nnCorner.CornerRadius = UDim.new(0, 3)
	nnCorner.Parent = newNameBox

	local newThreshBox = Instance.new("TextBox")
	newThreshBox.Size = UDim2.new(1, -8, 0, 20)
	newThreshBox.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	newThreshBox.BorderSizePixel = 0
	newThreshBox.Font = Enum.Font.Gotham
	newThreshBox.PlaceholderText = "Threshold (0-1 or 'nil')"
	newThreshBox.Text = "0.40"
	newThreshBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	newThreshBox.TextSize = 9
	newThreshBox.ClearTextOnFocus = false
	newThreshBox.LayoutOrder = nextOrder()
	newThreshBox.Parent = ThresholdEditorScroll

	local ntCorner = Instance.new("UICorner")
	ntCorner.CornerRadius = UDim.new(0, 3)
	ntCorner.Parent = newThreshBox

	local addCatBtn = Instance.new("TextButton")
	addCatBtn.Size = UDim2.new(1, -8, 0, 22)
	addCatBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 85)
	addCatBtn.BorderSizePixel = 0
	addCatBtn.Font = Enum.Font.GothamBold
	addCatBtn.Text = "+ ADD SLOT CATEGORY"
	addCatBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	addCatBtn.TextSize = 9
	addCatBtn.LayoutOrder = nextOrder()
	addCatBtn.Parent = ThresholdEditorScroll

	local acCorner = Instance.new("UICorner")
	acCorner.CornerRadius = UDim.new(0, 3)
	acCorner.Parent = addCatBtn

	addCatBtn.Activated:Connect(function()
		local cleanName = string.gsub(newNameBox.Text or "", "^%s*(.-)%s*$", "%1")
		if cleanName == "" then
			newNameBox.Text = ""
			newNameBox.PlaceholderText = "Enter name first!"
			return
		end

		local rawThresh = newThreshBox.Text
		local finalThresh
		if isNilThreshold(rawThresh) then
			finalThresh = "nil"
		else
			local parsedThresh = tonumber(rawThresh)
			if not parsedThresh then
				newThreshBox.Text = "0.40"
				return
			end
			finalThresh = normalizeThreshold(parsedThresh, 0.40)
		end

		local exists = false
		for _, cat in ipairs(ActiveCustomCategories) do
			if string.lower(cat.Name) == string.lower(cleanName) then
				cat.MaxRatio = finalThresh
				exists = true
				break
			end
		end

		if not exists then
			table.insert(ActiveCustomCategories, {
				Name = cleanName,
				MaxRatio = finalThresh
			})
		end

		ensureSubFolder(cleanName)
		selectedTierName = cleanName
		selectedItemKey = ""
		selectedItemDisplayName = ""
		selectedSubPartName = "Handle"

		saveProfileData()
		drawSaveSlotsInterface()
		updateTierUI()
		updateItemUI()
		updateEditorUI()
		updateThresholdEditorUI()

		if not isPreviewingMode and LocalPlayer.Character then
			lastPreset = ""
			forceRecalculateHealthPreset(LocalPlayer.Character)
		end
	end)

	for idx, cat in ipairs(ActiveCustomCategories) do
		local isCatNil = isNilThreshold(cat.MaxRatio)
		local cRow = Instance.new("Frame")
