local function applyPreset(character, folderName)
	clearActiveItems()
	if folderName == "" or folderName == "None" then return end
	
	local folder = TargetPresetFolder:FindFirstChild(folderName)
	if not folder then return end
	
	for _, item in ipairs(folder:GetChildren()) do
		if typeof(item) == "Instance" then
			task.spawn(localAttach, character, folderName, item)
		end
	end
	task.defer(highlightSelectedSubPart)
end

local function forceRecalculateHealthPreset(character)
	if isPreviewingMode then return end
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end
	
	local ratio = humanoid.Health / humanoid.MaxHealth
	local target = Config.SelectedDefault
	
	if ratio <= 0.15 then target = Config.SelectedCritical
	elseif ratio <= 0.30 then target = Config.SelectedMajor
	elseif ratio <= 0.50 then target = Config.SelectedMedium
	elseif ratio <= 0.75 then target = Config.SelectedMinor end
	
	lastPreset = target
	applyPreset(character, target)
end

local function monitorHealth(character)
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.HealthChanged:Connect(function() forceRecalculateHealthPreset(character) end)
	forceRecalculateHealthPreset(character)
end

local function generateExtractedPlaceholderModel(tierName, itemName)
	if type(itemName) ~= "string" or itemName == "" then return nil end
	local folder = TargetPresetFolder:FindFirstChild(tierName)
	if not folder then return nil end

	local existing = folder:FindFirstChild(itemName)
	if existing then return existing end
	
	local visualProfile = ExtractedVisuals[tierName] and ExtractedVisuals[tierName][itemName]
	if not visualProfile or type(visualProfile) ~= "table" then return nil end
	
	local fakeAccessory = Instance.new("Accessory")
	fakeAccessory.Name = itemName
	local handlePart = nil
	
	for partName, visualData in pairs(visualProfile) do
		if type(visualData) == "table" then
			local part = Instance.new("Part")
			part.Name = partName
			part.Transparency = 0
			part.Material = Enum.Material.Plastic
			part.Size = Vector3.new(visualData.SizeX or 1, visualData.SizeY or 1, visualData.SizeZ or 1)
			
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = Enum.MeshType.FileMesh
			
			local rawMesh = visualData.MeshId and tostring(visualData.MeshId) or ""
			local rawTexture = visualData.TextureId and tostring(visualData.TextureId) or ""
			
			sm.MeshId = string.match(rawMesh, "^%d+$") and ("rbxassetid://" .. rawMesh) or rawMesh
			sm.TextureId = string.match(rawTexture, "^%d+$") and ("rbxassetid://" .. rawTexture) or rawTexture
			sm.Scale = Vector3.new(1, 1, 1)
			sm.Parent = part
			part.Parent = fakeAccessory
			
			if partName == "Handle" then handlePart = part end
		end
	end
	
	if not handlePart then
		local backupHandle = fakeAccessory:FindFirstChildWhichIsA("BasePart")
		if backupHandle then backupHandle.Name = "Handle" end
	end
	
	fakeAccessory.Parent = folder
	return fakeAccessory
end

