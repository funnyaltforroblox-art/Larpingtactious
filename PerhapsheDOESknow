		rBtn.Activated:Connect(function()
			selectedSubPartName = pName
			dropDownWrapper.Visible = false
			updateEditorUI()
			highlightSelectedSubPart()
		end)
	end

	compDropdownScroll.CanvasSize = UDim2.new(0, 0, 0, #sorted * 22)
	
	local pData = itemProfile[selectedSubPartName]
	if pData then
		inputs["offsetX"].Text = tostring(pData.offsetX or 0)
		inputs["offsetY"].Text = tostring(pData.offsetY or 0)
		inputs["offsetZ"].Text = tostring(pData.offsetZ or 0)
		inputs["rotateX"].Text = tostring(pData.rotateX or 0)
		inputs["rotateY"].Text = tostring(pData.rotateY or 0)
		inputs["rotateZ"].Text = tostring(pData.rotateZ or 0)
		inputs["scaleX"].Text  = tostring(pData.scaleX or 1)
		inputs["scaleY"].Text  = tostring(pData.scaleY or 1)
		inputs["scaleZ"].Text  = tostring(pData.scaleZ or 1)
		inputs["transparency"].Text = string.format("%.2f", normalizeTransparency(pData.transparency, 0))
	end
end

updateItemUI = function()
	ItemSelectionPanel:ClearAllChildren()
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 4)
	listLayout.Parent = ItemSelectionPanel
	
	local targetFolder = TargetPresetFolder:FindFirstChild(selectedTierName)
	if not targetFolder then return end
	
	local children = targetFolder:GetChildren()
	if #children == 0 then
		selectedItemKey = ""
		selectedItemDisplayName = ""
		updateEditorUI()
		return
	end

	local nameCounts = {}
	for _, child in ipairs(children) do
		if typeof(child) == "Instance" then
			nameCounts[child.Name] = (nameCounts[child.Name] or 0) + 1
		end
	end

	local seenIndexByName = {}
	local hasSelectedInFolder = false

	for _, child in ipairs(children) do
		if typeof(child) == "Instance" then
			local itemKey = initializeItemData(selectedTierName, child, getItemKey(child))
			if itemKey == selectedItemKey then
				hasSelectedInFolder = true
			end

			seenIndexByName[child.Name] = (seenIndexByName[child.Name] or 0) + 1
			local buttonLabel = child.Name
			if (nameCounts[child.Name] or 0) > 1 then
				buttonLabel = string.format("%s (#%d)", child.Name, seenIndexByName[child.Name])
			end

			local iBtn = Instance.new("TextButton")
			iBtn.Size = UDim2.new(1, 0, 0, 26)
			iBtn.BackgroundColor3 = (itemKey == selectedItemKey) and Color3.fromRGB(0, 90, 160) or Color3.fromRGB(35, 35, 40)
			iBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			iBtn.Text = buttonLabel
			iBtn.Font = Enum.Font.GothamSemibold
			iBtn.TextSize = 10
			iBtn.Parent = ItemSelectionPanel
			
			iBtn.Activated:Connect(function()
				selectedItemKey = itemKey or ""
				selectedItemDisplayName = child.Name
				selectedSubPartName = "Handle"
				updateItemUI()
				updateEditorUI()
				highlightSelectedSubPart()
			end)
		end
	end

	if not hasSelectedInFolder then
		selectedItemKey = ""
		selectedItemDisplayName = ""
		updateEditorUI()
	end

	ItemSelectionPanel.CanvasSize = UDim2.new(0, 0, 0, #children * 30)
end

updateTierUI = function()
	TierSelectionPanel:ClearAllChildren()
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 4)
	listLayout.Parent = TierSelectionPanel
	
	local tiers = getAllTierNames()

	for _, tName in ipairs(tiers) do
		ensureSubFolder(tName)
		local isCustom = false
		for _, cat in ipairs(ActiveCustomCategories) do
			if cat.Name == tName then
				isCustom = true
				break
			end
		end

		local tBtn = Instance.new("TextButton")
		tBtn.Size = UDim2.new(1, 0, 0, 26)
		tBtn.BackgroundColor3 = (tName == selectedTierName) and Color3.fromRGB(120, 80, 0) or (isCustom and Color3.fromRGB(32, 46, 62) or Color3.fromRGB(35, 35, 40))
		tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		tBtn.Text = isCustom and (tName .. " *") or tName
		tBtn.Font = Enum.Font.GothamBold
		tBtn.TextSize = 10
		tBtn.Parent = TierSelectionPanel
		
		tBtn.Activated:Connect(function()
			selectedTierName = tName
			selectedItemKey = ""
			selectedItemDisplayName = ""
			selectedSubPartName = "Handle"

			updateTierUI()
			updateItemUI()
			updateEditorUI()
			clearActiveHighlight()
			
			if isPreviewingMode then runUpdatePreviewCycle() end
		end)
	end

	TierSelectionPanel.CanvasSize = UDim2.new(0, 0, 0, #tiers * 30)
end

restoreAllTierAssets = function()
	if type(AssetIdsToLoad) == "table" then
		for tierName, idList in pairs(AssetIdsToLoad) do
			if type(idList) == "table" then
				for _, entry in ipairs(idList) do
					if type(entry) == "table" and entry.Id ~= nil then
						local validId = entry.Id
						local validTier = tierName
						local validKey = entry.Key
						task.spawn(function()
							injectAssetId(validId, validTier, true, validKey)
						end)
					elseif entry ~= nil then
						local validId = entry
						local validTier = tierName
						task.spawn(function()
							injectAssetId(validId, validTier, true)
						end)
					end
				end
			end
		end
	end
	
	if type(ExtractedNamesToLoad) == "table" then
		for tierName, extractionList in pairs(ExtractedNamesToLoad) do
			if type(extractionList) == "table" then
				for _, entry in ipairs(extractionList) do
					if type(entry) == "table" and type(entry.Name) == "string" and entry.Name ~= "" then
						generateExtractedPlaceholderModel(tierName, entry.Name, entry.Key)
					elseif type(entry) == "string" and entry ~= "" then
						generateExtractedPlaceholderModel(tierName, entry)
					end
				end
			end
		end
	end

	task.wait(0.2)
	updateItemUI()
	updateEditorUI()
end

