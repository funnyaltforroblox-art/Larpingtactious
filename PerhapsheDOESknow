local function cloneTable(tbl)
	if type(tbl) ~= "table" then return {} end
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(tbl)
	end)
	if ok and encoded then
		local okDec, decoded = pcall(function()
			return HttpService:JSONDecode(encoded)
		end)
		if okDec and type(decoded) == "table" then
			return decoded
		end
	end
	return {}
end

local function isNilThreshold(val)
	if val == nil then return true end
	if type(val) == "string" then
		local trimmed = string.lower(string.gsub(val, "^%s*(.-)%s*$", "%1"))
		if trimmed == "nil" or trimmed == "none" or trimmed == "" then
			return true
		end
	end
	return false
end

local function normalizeThreshold(val, fallback)
	if isNilThreshold(val) then
		return "nil"
	end
	local num = tonumber(val)
	if not num then
		if isNilThreshold(fallback) then
			return "nil"
		end
		local fbNum = tonumber(fallback) or 0.5
		if fbNum > 1 then fbNum = fbNum / 100 end
		return math.clamp(fbNum, 0, 1)
	end
	if num > 1 then
		num = num / 100
	end
	return math.clamp(num, 0, 1)
end

local function formatThresholdText(val)
	if isNilThreshold(val) then
		return "nil"
	end
	local num = tonumber(val)
	if not num then return "nil" end
	return string.format("%.2f", math.clamp(num, 0, 1))
end

local function normalizeTransparency(val, fallback)
	local num = tonumber(val)
	if not num then
		num = tonumber(fallback) or 0
	end
	return math.clamp(num, 0, 1)
end

