				end

				if isPreviewingMode then
					runUpdatePreviewCycle()
				elseif LocalPlayer.Character then
					applyPreset(LocalPlayer.Character, lastPreset)
				end
				saveProfileData()
			elseif isTransparencyField then
				textBox.Text = string.format("%.2f", normalizeTransparency(tierData[selectedItemKey][selectedSubPartName][property], 0))
			end
		end
	end)

	inputs[property] = textBox
